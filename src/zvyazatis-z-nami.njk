---
layout: base.njk
pagination:
  data: locales
  size: 1
  alias: locale
  addAllPagesToCollections: true
permalink: "{{ '/en/zvyazatis-z-nami/' if locale == 'en' else '/zvyazatis-z-nami/' }}"
title: Контакти та зворотній зв'язок | Фонд розвитку міжнародної співпраці
description: Пошта, телефон, адреса та форма зворотного зв'язку фонду.
enTitle: Contacts | International Cooperation Development Fund
enDescription: Email, phone, address and feedback form of the fund.
eleventyComputed:
  title: "{{ (enTitle if locale == 'en' else title) | safe }}"
  description: "{{ (enDescription if locale == 'en' else description) | safe }}"
---
      <section class="page-hero">
        <div>
          <p class="eyebrow">{{ feedback.hero.eyebrow }}</p>
          <h1>{{ feedback.hero.heading }}</h1>
          <p class="lead">{{ feedback.hero.lead }}</p>
        </div>
      </section>
      <section class="section contacts-layout">
        <div class="contacts-col">
          <h2>{{ "Contact us directly" if locale == "en" else "Напишіть нам напряму" }}</h2>
          <div class="contact-cards">
          <a class="contact-card" href="mailto:{{ contacts.general }}">
            <span>Email</span>
            <strong>{{ contacts.general }}</strong>
          </a>
          {%- if contacts.phone %}
          <a class="contact-card" href="tel:{{ contacts.phone | replace(" ", "") }}">
            <span>{{ "Phone" if locale == "en" else "Телефон" }}</span>
            <strong>{{ contacts.phone }}</strong>
          </a>
          {%- endif %}
          {%- if contacts.address %}
          <a class="contact-card" href="https://maps.google.com/?q={{ contacts.address | urlencode }}" target="_blank" rel="noopener">
            <span>{{ "Address" if locale == "en" else "Адреса" }}</span>
            <strong>{{ contacts.address }}</strong>
          </a>
          {%- endif %}
          </div>
        </div>
        <div class="form-col">
          <h2>{{ "Feedback form" if locale == "en" else "Форма зворотного зв'язку" }}</h2>
        <form class="feedback-form" id="feedback-form" data-locale="{{ locale }}">
          <div class="form-row">
            <label for="fb-name">{{ "Name" if locale == "en" else "Ім'я" }}</label>
            <input type="text" id="fb-name" name="name" required>
          </div>
          <div class="form-row">
            <label for="fb-email">Email</label>
            <input type="email" id="fb-email" name="email" required>
          </div>
          <div class="form-row">
            <label for="fb-message">{{ "Message" if locale == "en" else "Повідомлення" }}</label>
            <textarea id="fb-message" name="message" rows="6" required></textarea>
          </div>
          <button class="button button-accent" type="submit">{{ "Send" if locale == "en" else "Надіслати" }}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg></button>
          <p class="form-note">{{ ("After clicking “Send” your email client will open with a message pre-filled to " if locale == "en" else "Після натискання «Надіслати» відкриється ваш поштовий клієнт із заповненим листом на адресу ") }}{{ feedback.submitEmail }}.</p>
        </form>
        </div>
      </section>
      <script>
        (function () {
          var form = document.getElementById("feedback-form");
          if (!form) return;
          var isEn = form.dataset.locale === "en";
          form.addEventListener("submit", function (e) {
            e.preventDefault();
            if (!form.reportValidity()) return;
            var name = form.name.value.trim();
            var email = form.email.value.trim();
            var message = form.message.value.trim();
            var subject = encodeURIComponent((isEn ? "Inquiry from " : "Звернення від ") + name);
            var nameLabel = isEn ? "Name: " : "Ім'я: ";
            var body = encodeURIComponent(nameLabel + name + "\nEmail: " + email + "\n\n" + message);
            window.location.href = "mailto:{{ feedback.submitEmail }}?subject=" + subject + "&body=" + body;
          });
        })();
      </script>
