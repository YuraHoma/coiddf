---
layout: base.njk
pagination:
  data: locales
  size: 1
  alias: locale
  addAllPagesToCollections: true
permalink: "{{ '/en/zvyazatis-z-nami/' if locale == 'en' else '/zvyazatis-z-nami/' }}"
title: Зв'язатися з нами | Фонд розвитку міжнародної співпраці
description: Форма зворотного зв'язку — запити, скарги та кар'єрні можливості.
enTitle: Contact Us | International Cooperation Development Fund
enDescription: Feedback form — inquiries, complaints and career opportunities.
eleventyComputed:
  title: "{{ enTitle if locale == 'en' else title }}"
  description: "{{ enDescription if locale == 'en' else description }}"
---
      <section class="page-hero">
        <div>
          <p class="eyebrow">{{ feedback.hero.eyebrow }}</p>
          <h1>{{ feedback.hero.heading }}</h1>
          <p class="lead">{{ feedback.hero.lead }}</p>
        </div>
      </section>
      <section class="section">
        <div class="contact-cards">
          <a class="contact-card" href="mailto:{{ site.contacts.general }}">
            <span>Email</span>
            <strong>{{ site.contacts.general }}</strong>
          </a>
          {%- if site.contacts.phone %}
          <a class="contact-card" href="tel:{{ site.contacts.phone | replace(" ", "") }}">
            <span>{{ "Phone" if locale == "en" else "Телефон" }}</span>
            <strong>{{ site.contacts.phone }}</strong>
          </a>
          {%- endif %}
          {%- if site.contacts.address %}
          <a class="contact-card" href="https://maps.google.com/?q={{ site.contacts.address | urlencode }}" target="_blank" rel="noopener">
            <span>{{ "Address" if locale == "en" else "Адреса" }}</span>
            <strong>{{ site.contacts.address }}</strong>
          </a>
          {%- endif %}
        </div>
      </section>
      <section class="section">
        <div class="section-heading center">
          <h2>{{ "Feedback form" if locale == "en" else "Форма зворотного зв'язку" }}</h2>
        </div>
        <form class="feedback-form" id="feedback-form" data-locale="{{ locale }}">
          <div class="form-row">
            <label for="fb-name">{{ "Name" if locale == "en" else "Ім'я" }}</label>
            <input type="text" id="fb-name" name="name" required>
          </div>
          <div class="form-row">
            <label for="fb-email">Email</label>
            <input type="email" id="fb-email" name="email" required>
          </div>
          <div class="form-row">
            <label for="fb-category">{{ "Inquiry category" if locale == "en" else "Категорія звернення" }}</label>
            <select id="fb-category" name="category" required>
              {%- for c in feedback.categories %}
              <option value="{{ c }}">{{ c }}</option>
              {%- endfor %}
            </select>
          </div>
          <div class="form-row">
            <label for="fb-message">{{ "Message" if locale == "en" else "Повідомлення" }}</label>
            <textarea id="fb-message" name="message" rows="6" required></textarea>
          </div>
          <button class="button button-accent" type="submit">{{ "Send" if locale == "en" else "Надіслати" }}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg></button>
          <p class="form-note">{{ ("After clicking “Send” your email client will open with a message pre-filled to " if locale == "en" else "Після натискання «Надіслати» відкриється ваш поштовий клієнт із заповненим листом на адресу ") }}{{ feedback.submitEmail }}.</p>
        </form>
      </section>
      <script>
        (function () {
          var form = document.getElementById("feedback-form");
          if (!form) return;
          var isEn = form.dataset.locale === "en";
          form.addEventListener("submit", function (e) {
            e.preventDefault();
            if (!form.reportValidity()) return;
            var name = form.name.value.trim();
            var email = form.email.value.trim();
            var category = form.category.value;
            var message = form.message.value.trim();
            var subjectPrefix = isEn ? "] Inquiry from " : "] Звернення від ";
            var subject = encodeURIComponent("[" + category + subjectPrefix + name);
            var bodyLabels = isEn
              ? { name: "Name: ", category: "Category: " }
              : { name: "Ім'я: ", category: "Категорія: " };
            var body = encodeURIComponent(
              bodyLabels.name + name + "\nEmail: " + email + "\n" + bodyLabels.category + category + "\n\n" + message
            );
            window.location.href = "mailto:{{ feedback.submitEmail }}?subject=" + subject + "&body=" + body;
          });
        })();
      </script>
