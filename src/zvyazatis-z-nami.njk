---
layout: base.njk
pagination:
  data: locales
  size: 1
  alias: locale
  addAllPagesToCollections: true
permalink: "{{ '/en/zvyazatis-z-nami/' if locale == 'en' else '/zvyazatis-z-nami/' }}"
title: "Контакти | Фонд розвитку міжнародної співпраці"
description: Пошта, телефон, адреса та форма зворотного зв'язку фонду.
enTitle: Contacts | International Cooperation Development Fund
enDescription: Email, phone, address and feedback form of the fund.
eleventyComputed:
  title: "{{ (enTitle if locale == 'en' else title) | safe }}"
  description: "{{ (enDescription if locale == 'en' else description) | safe }}"
---
      <section class="page-hero">
        <div>
          <p class="eyebrow">{{ feedback.hero.eyebrow }}</p>
          <h1>{{ feedback.hero.heading }}</h1>
          <p class="lead">{{ feedback.hero.lead }}</p>
        </div>
      </section>
      <section class="section contacts-layout">
        <div class="contacts-col">
          <h2>{{ "Contact us directly" if locale == "en" else "Напишіть нам напряму" }}</h2>
          <div class="contact-cards">
          <a class="contact-card" href="mailto:{{ contacts.general }}">
            <span>Email</span>
            <strong>{{ contacts.general }}</strong>
          </a>
          {%- if contacts.phone %}
          <a class="contact-card" href="tel:{{ contacts.phone | replace(" ", "") }}">
            <span>{{ "Phone" if locale == "en" else "Телефон" }}</span>
            <strong>{{ contacts.phone }}</strong>
          </a>
          {%- endif %}
          {%- if contacts.address %}
          <a class="contact-card" href="https://maps.google.com/?q={{ contacts.address | urlencode }}" target="_blank" rel="noopener">
            <span>{{ "Address" if locale == "en" else "Адреса" }}</span>
            <strong>{{ contacts.address }}</strong>
          </a>
          {%- endif %}
          </div>
        </div>
        <div class="form-col">
          <h2>{{ "Feedback form" if locale == "en" else "Форма зворотного зв'язку" }}</h2>
        <form class="feedback-form" id="feedback-form" data-locale="{{ locale }}">
          {#- Категорія звернення показується лише коли клієнт заповнив
              список у CMS; поки він порожній — поля просто немає. -#}
          {%- if feedback.categories and feedback.categories.length %}
          <div class="form-row">
            <label for="fb-category">{{ "Reason for your enquiry" if locale == "en" else "Причина звернення" }}</label>
            <select id="fb-category" name="category" required>
              <option value="" disabled selected>{{ "Select a reason" if locale == "en" else "Оберіть причину" }}</option>
              {%- for c in feedback.categories %}
              <option value="{{ c }}">{{ c }}</option>
              {%- endfor %}
            </select>
          </div>
          {%- endif %}
          <div class="form-row">
            <label for="fb-phone">{{ "Phone number" if locale == "en" else "Номер телефону" }}</label>
            <input type="tel" id="fb-phone" name="phone" autocomplete="tel">
          </div>
          <div class="form-row-pair">
            <div class="form-row">
              <label for="fb-firstname">{{ "First name" if locale == "en" else "Ім'я" }}</label>
              <input type="text" id="fb-firstname" name="firstname" autocomplete="given-name" required>
            </div>
            <div class="form-row">
              <label for="fb-lastname">{{ "Last name" if locale == "en" else "Прізвище" }}</label>
              <input type="text" id="fb-lastname" name="lastname" autocomplete="family-name" required>
            </div>
          </div>
          <div class="form-row">
            <label for="fb-email">Email</label>
            <input type="email" id="fb-email" name="email" autocomplete="email" required>
          </div>
          <div class="form-row">
            <label for="fb-message">{{ "Message" if locale == "en" else "Повідомлення" }}</label>
            <textarea id="fb-message" name="message" rows="6" required></textarea>
          </div>
          {#- Приховане поле-пастка для ботів: люди його не бачать і не заповнюють. -#}
          <div class="form-honeypot" aria-hidden="true"><label for="fb-website">Website</label><input type="text" id="fb-website" name="website" tabindex="-1" autocomplete="off"></div>
          {#- Підпис окремим <span>: скрипт міняє текст лише в ньому, тож
              стрілка лишається на місці після надсилання. -#}
          <button class="button button-accent" type="submit" data-label="{{ "Send" if locale == "en" else "Надіслати" }}" data-sending="{{ "Sending…" if locale == "en" else "Надсилаємо…" }}"><span class="btn-label">{{ "Send" if locale == "en" else "Надіслати" }}</span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg></button>
          <p class="form-error" id="form-error" role="alert" tabindex="-1" hidden></p>
          {#- Форму надсилає скрипт. Якщо він не виконався — вимкнений JS,
              корпоративний фільтр, збій мережі — кнопка мовчки нічого не
              робила б. Даємо звичайне посилання на пошту фонду. -#}
          <noscript>
            <p class="form-note">
              {{ "The form needs JavaScript. Write to us directly:" if locale == "en" else "Для надсилання форми потрібен JavaScript. Напишіть нам напряму:" }}
              <a href="mailto:{{ contacts.general }}">{{ contacts.general }}</a>
            </p>
          </noscript>
        </form>
        </div>
      </section>
      {#- Вікно підтвердження. Показується лише після успішної відповіді
          сервера, тож користувач не бачить «дякуємо» на невдалу спробу. -#}
      <div class="modal-backdrop" id="form-success" hidden>
        <div class="modal" role="dialog" aria-modal="true" aria-labelledby="form-success-title">
          <span class="modal-mark" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </span>
          <h2 id="form-success-title">{{ "Message sent" if locale == "en" else "Звернення надіслано" }}</h2>
          <p>{{ "Thank you — we have received your message and will reply to the email you provided." if locale == "en" else "Дякуємо — ми отримали ваше звернення й відповімо на вказану пошту." }}</p>
          <button class="button button-accent" type="button" id="form-success-close">{{ "Close" if locale == "en" else "Закрити" }}</button>
        </div>
      </div>
      <script>
        (function () {
          var form = document.getElementById("feedback-form");
          if (!form) return;
          var isEn = form.dataset.locale === "en";
          var btn = form.querySelector('button[type="submit"]');
          var errBox = document.getElementById("form-error");
          var modal = document.getElementById("form-success");
          var closeBtn = document.getElementById("form-success-close");
          var lastFocus = null;

          var MSG = isEn
            ? { failed: "Could not send the message. Please try again or write to ", network: "No connection to the server. Please try again or write to " }
            : { failed: "Не вдалося надіслати звернення. Спробуйте ще раз або напишіть на ", network: "Немає зв'язку із сервером. Спробуйте ще раз або напишіть на " };
          var MAIL = "{{ contacts.general }}";

          function showError(text) {
            errBox.innerHTML = text + '<a href="mailto:' + MAIL + '">' + MAIL + '</a>.';
            errBox.hidden = false;
            /* role="alert" оголошує текст, фокус дає змогу одразу дійти
               до посилання на пошту з клавіатури. */
            errBox.focus();
          }
          function openModal() {
            modal.hidden = false;
            document.body.style.overflow = "hidden";
            requestAnimationFrame(function () { modal.classList.add("in"); });
            closeBtn.focus();
          }
          function closeModal() {
            modal.classList.remove("in");
            document.body.style.overflow = "";
            setTimeout(function () { modal.hidden = true; }, 300);
            /* Повертаємо фокус туди, звідки прийшли: кнопка на момент
               відкриття вимкнена, тож точку повернення запамʼятали до неї. */
            if (lastFocus && document.contains(lastFocus)) lastFocus.focus();
          }
          closeBtn.addEventListener("click", closeModal);
          modal.addEventListener("click", function (e) { if (e.target === modal) closeModal(); });
          document.addEventListener("keydown", function (e) {
            if (modal.hidden) return;
            if (e.key === "Escape") { closeModal(); return; }
            /* Утримання фокуса: у вікні лише одна кнопка, тож Tab має
               лишатися на ній, а не йти на сховану за бекдропом сторінку. */
            if (e.key === "Tab") {
              e.preventDefault();
              closeBtn.focus();
            }
          });

          form.addEventListener("submit", function (e) {
            e.preventDefault();
            if (!form.reportValidity()) return;
            errBox.hidden = true;

            var val = function (n) { return form[n] ? form[n].value.trim() : ""; };
            var payload = {
              firstname: val("firstname"), lastname: val("lastname"),
              email: val("email"), phone: val("phone"),
              category: val("category"), message: val("message"),
              website: val("website")
            };

            lastFocus = btn;
            btn.disabled = true;
            btn.querySelector(".btn-label").textContent = btn.dataset.sending;

            fetch("/api/contact", {
              method: "POST",
              headers: { "content-type": "application/json" },
              body: JSON.stringify(payload)
            })
              .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, data: d }; }); })
              .then(function (r) {
                if (r.ok && r.data.ok) { form.reset(); openModal(); }
                else showError(MSG.failed);
              })
              .catch(function () { showError(MSG.network); })
              .finally(function () {
                btn.disabled = false;
                btn.querySelector(".btn-label").textContent = btn.dataset.label;
              });
          });
        })();
      </script>
