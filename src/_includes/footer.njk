    <footer class="footer footer-big">
      <div class="footer-top">
        <div class="footer-brand-nav">
          <a class="footer-brand" href="{{ '/en/' if locale == 'en' else '/' }}" aria-label="{{ site.orgShort }}">
            <span class="footer-brand-mark">{% include "logo.njk" %}</span>
            <span class="footer-brand-name">
              <small>{{ site.orgLine1 | upper }}</small>
              <strong>{{ site.orgLine2 | upper }}</strong>
            </span>
          </a>
          <nav class="footer-nav-cols" aria-label="{{ 'Footer navigation' if locale == 'en' else 'Навігація футера' }}">
            <div class="footer-nav-col">
              {%- for item in site.footerNavCol1 %}
              <a href="{{ item.href }}">{{ item.label }}</a>
              {%- endfor %}
            </div>
            <div class="footer-nav-col">
              {#- Посилання на новини показуємо лише тоді, коли новини є:
                  порожній розділ на сайті гірший за його відсутність.
                  Щойно в CMS зʼявиться перша новина — посилання повернеться
                  само, руками нічого вмикати не треба. -#}
              {%- set hasNews = (en.newsPosts if locale == "en" else collections.news) | length %}
              {%- for item in site.footerNavCol2 %}
              {%- if "/novyny/" not in item.href or hasNews %}
              <a href="{{ item.href }}">{{ item.label }}</a>
              {%- endif %}
              {%- endfor %}
            </div>
          </nav>
        </div>
        <div class="footer-contacts">
          <div class="footer-contact-row">
            <span>{{ "Contact" if locale == "en" else "Контакти" }}</span>
            <a href="mailto:{{ contacts.general }}">{{ contacts.general }} ↗</a>
          </div>
          {%- if contacts.phone %}
          <div class="footer-contact-row">
            <span>{{ "Phone" if locale == "en" else "Телефон" }}</span>
            <a href="tel:{{ contacts.phone | replace(" ", "") }}">{{ contacts.phone }} ↗</a>
          </div>
          {%- endif %}
          {%- if contacts.address %}
          <div class="footer-contact-row">
            <span>{{ "Address" if locale == "en" else "Адреса" }}</span>
            <a href="https://maps.google.com/?q={{ contacts.address | urlencode }}" target="_blank" rel="noopener">{{ contacts.address }} ↗</a>
          </div>
          {%- endif %}
        </div>
        <div class="footer-cta-col">
          {#- Іконки стоять заглушками, поки клієнт не дасть посилання:
              з URL — посилання, без URL — приглушений значок без дії. -#}
          <div class="footer-social-label">{{ "Follow us" if locale == "en" else "Ми в соц. мережах" }}</div>
          <div class="footer-socials" aria-label="{{ 'Social media' if locale == 'en' else 'Соціальні мережі' }}">
            {%- if contacts.socials.facebook %}
            <a href="{{ contacts.socials.facebook }}" target="_blank" rel="noopener" aria-label="Facebook">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
            </a>
            {%- else %}
            <span class="is-placeholder" role="img" aria-label="Facebook — {{ "link coming soon" if locale == "en" else "посилання буде додано" }}" title="{{ "Link coming soon" if locale == "en" else "Посилання буде додано" }}">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
            </span>
            {%- endif %}
            {%- if contacts.socials.twitter %}
            <a href="{{ contacts.socials.twitter }}" target="_blank" rel="noopener" aria-label="Twitter / X">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </a>
            {%- else %}
            <span class="is-placeholder" role="img" aria-label="Twitter / X — {{ "link coming soon" if locale == "en" else "посилання буде додано" }}" title="{{ "Link coming soon" if locale == "en" else "Посилання буде додано" }}">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </span>
            {%- endif %}
            {%- if contacts.socials.linkedin %}
            <a href="{{ contacts.socials.linkedin }}" target="_blank" rel="noopener" aria-label="LinkedIn">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.03-1.85-3.03-1.85 0-2.14 1.45-2.14 2.94v5.66H9.36V9h3.41v1.56h.05c.48-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.46zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.11 20.45H3.56V9h3.55z"/></svg>
            </a>
            {%- else %}
            <span class="is-placeholder" role="img" aria-label="LinkedIn — {{ "link coming soon" if locale == "en" else "посилання буде додано" }}" title="{{ "Link coming soon" if locale == "en" else "Посилання буде додано" }}">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.03-1.85-3.03-1.85 0-2.14 1.45-2.14 2.94v5.66H9.36V9h3.41v1.56h.05c.48-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.46zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.11 20.45H3.56V9h3.55z"/></svg>
            </span>
            {%- endif %}
            {%- if contacts.socials.viber %}
            <a href="{{ contacts.socials.viber }}" target="_blank" rel="noopener" aria-label="Viber">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.6c-3.2 0-5.4.6-6.8 1.9C3.6 5.9 3.1 8 3.1 10.8c0 2.8.4 4.9 1.9 6.4.6.6 1.4 1 2.3 1.3v2.6c0 .6.6.9 1 .5l2-2.1c.5 0 1 .1 1.7.1 3.2 0 5.4-.6 6.8-1.9 1.6-1.4 2.1-3.5 2.1-6.3 0-2.8-.5-4.9-2.1-6.3C17.4 3.2 15.2 2.6 12 2.6Z"/><path d="M9.2 7.4c.4-.1.8.1 1 .5l.7 1.3c.2.4.1.8-.2 1l-.4.3c.4 1 1.2 1.8 2.2 2.2l.3-.4c.3-.3.7-.4 1-.2l1.3.7c.4.2.6.6.5 1-.2.9-1 1.5-1.9 1.4-2.8-.3-5-2.5-5.3-5.3-.1-.9.5-1.7 1.4-1.9Z"/><path d="M13.2 6.6a4.3 4.3 0 0 1 3.6 3.6M13.4 9.2a1.8 1.8 0 0 1 1.4 1.4"/></svg>
            </a>
            {%- else %}
            <span class="is-placeholder" role="img" aria-label="Viber — {{ "link coming soon" if locale == "en" else "посилання буде додано" }}" title="{{ "Link coming soon" if locale == "en" else "Посилання буде додано" }}">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.6c-3.2 0-5.4.6-6.8 1.9C3.6 5.9 3.1 8 3.1 10.8c0 2.8.4 4.9 1.9 6.4.6.6 1.4 1 2.3 1.3v2.6c0 .6.6.9 1 .5l2-2.1c.5 0 1 .1 1.7.1 3.2 0 5.4-.6 6.8-1.9 1.6-1.4 2.1-3.5 2.1-6.3 0-2.8-.5-4.9-2.1-6.3C17.4 3.2 15.2 2.6 12 2.6Z"/><path d="M9.2 7.4c.4-.1.8.1 1 .5l.7 1.3c.2.4.1.8-.2 1l-.4.3c.4 1 1.2 1.8 2.2 2.2l.3-.4c.3-.3.7-.4 1-.2l1.3.7c.4.2.6.6.5 1-.2.9-1 1.5-1.9 1.4-2.8-.3-5-2.5-5.3-5.3-.1-.9.5-1.7 1.4-1.9Z"/><path d="M13.2 6.6a4.3 4.3 0 0 1 3.6 3.6M13.4 9.2a1.8 1.8 0 0 1 1.4 1.4"/></svg>
            </span>
            {%- endif %}
            {%- if contacts.socials.whatsapp %}
            <a href="{{ contacts.socials.whatsapp }}" target="_blank" rel="noopener" aria-label="WhatsApp">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
            </a>
            {%- else %}
            <span class="is-placeholder" role="img" aria-label="WhatsApp — {{ "link coming soon" if locale == "en" else "посилання буде додано" }}" title="{{ "Link coming soon" if locale == "en" else "Посилання буде додано" }}">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
            </span>
            {%- endif %}
          </div>
          <a class="button footer-contact-btn" href="{{ site.contactUrl }}">
            {{ "Contact us" if locale == "en" else "Зв'язатися з нами" }} <span>↗</span>
          </a>
        </div>
      </div>
      <div class="footer-bottom">
        {#- Повна юридична назва мовою сторінки. Код ЄДРПОУ прибрано до
            підтвердження клієнтом; поле лишається в CMS. -#}
        <span class="footer-legal">{{ site.orgFull }}{% if legal.edrpou %} ({{ "EDRPOU code: " if locale == "en" else "Код ЄДРПОУ: " }}{{ legal.edrpou }}){% endif %}</span>
        <span>© {{ buildYear }}. {{ "All rights reserved." if locale == "en" else "Всі права захищені." }}</span>
      </div>
    </footer>
