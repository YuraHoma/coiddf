{# Логотипи партнерів — зображення з матеріалів клієнта.
   Раніше тут були намальовані інлайнові SVG під п'ять вигаданих
   партнерів; після переходу на реальний перелік логотипи зберігаються
   файлами в src/assets і приходять у макрос разом з даними партнера. #}
{% macro logo(p) -%}
{%- if p.image -%}
<img src="{{ p.image }}" alt="{{ p.name }}" loading="lazy">
{%- else -%}
<span class="partner-logo-text">{{ p.name }}</span>
{%- endif -%}
{%- endmacro %}
