    <header class="site-header">
      <a class="brand" href="{{ '/en/' if locale == 'en' else '/' }}" aria-label="{{ site.orgFull }}">
        {#- Назва поруч з емблемою — текстом, а не в SVG: так вона
            перекладається разом із рештою сайту. -#}
        <span class="brand-mark">{% include "logo.njk" %}</span>
        <span>
          <small>{{ site.orgLine1 | upper }}</small>
          <strong>{{ site.orgLine2 | upper }}</strong>
        </span>
      </a>
      <button class="nav-toggle" type="button" aria-label="{{ 'Menu' if locale == 'en' else 'Меню' }}" aria-expanded="false"><span></span></button>
      <nav class="nav" aria-label="{{ 'Main navigation' if locale == 'en' else 'Головна навігація' }}">
        {#- Активний пункт визначається за префіксом розділу, а не точною
            рівністю: інакше сторінки-деталі (/proyekty/<слаг>/, статті
            новин) не підсвічують нічого і відвідувач губить позицію.
            Для головної («/» та «/en/») лишається точний збіг — її
            префікс містить усі решта адрес. -#}
        {%- for item in site.nav %}
        {%- set isHome = item.href == "/" or item.href == "/en/" %}
        {%- set isActive = (page.url == item.href) if isHome else page.url.startsWith(item.href) %}
        <a href="{{ item.href }}"{% if isActive %} class="active" aria-current="page"{% endif %}>{{ item.label }}</a>
        {%- endfor %}
      </nav>
      <div class="header-right">
        {#- Кнопки «Зв'язатися з нами» в хедері немає: контакти окремим
            пунктом меню, як у ТЗ. -#}
        <a class="lang-toggle" href="{{ altUrl }}" aria-label="Switch language / Змінити мову">{{ "UA" if locale == "en" else "EN" }}</a>
      </div>
    </header>
