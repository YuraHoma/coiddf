<!doctype html>
{%- set altUrl = page.url.slice(3) if locale == "en" else "/en" + page.url %}
<html lang="{{ locale }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }}</title>
    <meta name="description" content="{{ description or excerpt }}">
    {%- if noindex %}
    <meta name="robots" content="noindex">
    {%- else %}
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">
    <link rel="alternate" hreflang="uk" href="{{ site.url }}{{ page.url if locale == 'uk' else altUrl }}">
    <link rel="alternate" hreflang="en" href="{{ site.url }}{{ page.url if locale == 'en' else altUrl }}">
    <link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ page.url if locale == 'uk' else altUrl }}">
    {%- endif %}
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon-16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png">
    <meta name="theme-color" content="#5A7D3D">
    <meta property="og:type" content="{% if page.url and '/novyny/' in page.url and page.url != '/novyny/' %}article{% else %}website{% endif %}">
    <meta property="og:site_name" content="{{ site.orgFull }}">
    <meta property="og:title" content="{{ title }}">
    <meta property="og:description" content="{{ description or excerpt }}">
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    <meta property="og:image" content="{{ site.url }}{{ image or '/assets/og-image.jpg' }}">
    <meta property="og:locale" content="{{ 'en_US' if locale == 'en' else 'uk_UA' }}">
    <meta name="twitter:card" content="summary_large_image">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Onest:wght@300..700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles.css">
  </head>
  <body>
{%- if legal.registration %}
    <div class="reg-strip">
      <ul>
        {%- for r in legal.registration %}
        <li><span>{{ r.label }}</span> <b>{{ r.value }}</b></li>
        {%- endfor %}
      </ul>
    </div>
{%- endif %}
{% include "header.njk" %}
    <main>
{{ content | safe }}
    </main>
{% include "footer.njk" %}
    {%- if site.cookie and site.cookie.text %}
    {#- Смуга згоди на cookie. Ховається до рішення користувача через
        hidden, щоб не блимала при завантаженні; вибір лишається в
        localStorage, тож більше не показується. -#}
    <div class="cookie-bar" id="cookie-bar" role="region" aria-label="{{ 'Cookie notice' if locale == 'en' else 'Повідомлення про cookie' }}" hidden>
      <p>{{ site.cookie.text }} <a href="{{ site.cookie.linkUrl }}">{{ site.cookie.linkLabel }} ↗</a></p>
      <button class="button button-accent" type="button" id="cookie-accept">{{ site.cookie.buttonLabel }}</button>
    </div>
    {%- endif %}
    <script>
      (function () {
        var d = document, root = d.documentElement;
        root.classList.add('js');

        /* Згода на cookie: показуємо смугу лише тим, хто ще не відповів. */
        var cookieBar = d.getElementById('cookie-bar');
        if (cookieBar) {
          var stored = null;
          try { stored = localStorage.getItem('icdf-cookie-consent'); } catch (e) {}
          if (!stored) {
            cookieBar.hidden = false;
            requestAnimationFrame(function () { cookieBar.classList.add('in'); });
          }
          var accept = d.getElementById('cookie-accept');
          if (accept) {
            accept.addEventListener('click', function () {
              try { localStorage.setItem('icdf-cookie-consent', 'accepted'); } catch (e) {}
              cookieBar.classList.remove('in');
              setTimeout(function () { cookieBar.hidden = true; }, 450);
            });
          }
        }

        var header = d.querySelector('.site-header');
        var toggle = d.querySelector('.nav-toggle');

        if (header && toggle) {
          toggle.addEventListener('click', function () {
            var open = header.classList.toggle('nav-open');
            toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
          });
          header.querySelectorAll('.nav a').forEach(function (a) {
            a.addEventListener('click', function () {
              header.classList.remove('nav-open');
              toggle.setAttribute('aria-expanded', 'false');
            });
          });
        }

        var lastY = 0, ticking = false;
        window.addEventListener('scroll', function () {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(function () {
            var y = window.pageYOffset || 0;
            if (header) header.classList.toggle('scrolled', y > 24);
            if (header && !header.classList.contains('nav-open')) {
              if (y > 120 && y > lastY) header.classList.add('header-hidden');
              else header.classList.remove('header-hidden');
            }
            lastY = y;
            ticking = false;
          });
        }, { passive: true });

        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        /* ротація акцентного слова в H1 (2.2s). Ширина фіксується під
           найдовше слово, щоб заголовок не перескакував між словами. */
        var accent = d.querySelector('.hero-top h1 .accent');
        if (accent && !reduce) {
          var words = root.lang === 'en'
            ? ['future', 'security', 'resilience', 'development']
            : ['майбутнє', 'безпеку', 'стійкість', 'розвиток'];
          var wi = Math.max(0, words.indexOf(accent.textContent.trim()));
          var soft = 'cubic-bezier(0.22, 0.61, 0.36, 1)';
          var show = 'opacity 420ms ' + soft + ', transform 420ms ' + soft;
          accent.style.display = 'inline-block';
          accent.style.transition = show;
          var maxWidth = 0;
          words.forEach(function (w) {
            accent.textContent = w;
            maxWidth = Math.max(maxWidth, accent.getBoundingClientRect().width);
          });
          accent.style.width = Math.ceil(maxWidth) + 'px';
          accent.textContent = words[wi];
          setInterval(function () {
            accent.style.opacity = '0';
            accent.style.transform = 'translateY(0.45em)';
            setTimeout(function () {
              wi = (wi + 1) % words.length;
              accent.textContent = words[wi];
              accent.style.transition = 'none';
              accent.style.transform = 'translateY(-0.45em)';
              void accent.offsetHeight;
              accent.style.transition = show;
              accent.style.opacity = '1';
              accent.style.transform = 'translateY(0)';
            }, 440);
          }, 2600);
        }
        if (reduce || !('IntersectionObserver' in window)) return;
{%- if page.url == "/" or page.url == "/en/" %}
        /* Анімація появи при скролі лишається тільки на головній —
           на внутрішніх сторінках вона заважає читати. */
        var sel = '.section-heading,.intro-photos,.intro-story-top > p,' +
          '.map-card,.cards-grid article,.process-grid article,' +
          '.resource-card,.partner-marquee,.partner-detail-card,.news-mini-grid article,.news-grid article,' +
          '.principles-grid article,.capacity-grid article,.about-note,.about-copy,' +
          '.team-leads article,.team-grid article,.feedback-form,' +
          '.project-list > *,.contact-list span,.award-card,.cta-band > div';
        var els = [].slice.call(d.querySelectorAll(sel));
        els.forEach(function (el) {
          el.setAttribute('data-reveal', '');
          var p = el.parentNode, idx = p ? [].indexOf.call(p.children, el) : 0;
          el.style.transitionDelay = (Math.min(idx, 6) * 60) + 'ms';
        });
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
          });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
        els.forEach(function (el) { io.observe(el); });
{%- endif %}
      })();
    </script>
  </body>
</html>
