<!doctype html>
{#- 404 існує в одному примірнику і вже двомовна, тож пари /en/404.html
    у неї немає — перемикач веде на англійську головну, інакше це було б
    єдине бите посилання на сайті. -#}
{%- set altUrl = "/en/" if page.url == "/404.html" else (page.url.slice(3) if locale == "en" else "/en" + page.url) %}
{#- Тип сторінки визначаємо по URL без мовного префікса, щоб одна умова
    покривала і /novyny/x/, і /en/novyny/x/. Порівняння з індексом
    («/novyny/») відсікає список новин від самої статті. -#}
{%- set urlPath = (page.url or "/") | replace("/en/", "/") %}
{%- set isNewsPost = urlPath.indexOf("/novyny/") == 0 and urlPath != "/novyny/" %}
{%- set isProjectPost = urlPath.indexOf("/proyekty/") == 0 and urlPath != "/proyekty/" %}
{%- set isContactPage = urlPath == "/zvyazatis-z-nami/" %}
{#- На англійських статтях дані лежать у pagination-аліасі (post/project),
    на українських — у front matter самого md. -#}
{%- set artSrc = post or project %}
{%- set artTitle = artSrc.title if artSrc else title %}
{%- set artDate = artSrc.date if artSrc else date %}
{%- set artExcerpt = artSrc.excerpt if artSrc else excerpt %}
{#- Одне джерело правди для соцкартки: og:image і image в JSON-LD ведуть на
    той самий файл. Для обкладинок новин/проєктів це jpeg-похідна з
    /assets/social/ (див. src/_data/social.js) — сирі оригінали в прод
    не копіюються. -#}
{%- set pageImageUrl = site.url + (social[image] or image or "/assets/og-image.jpg") %}
<html lang="{{ locale }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {#- Офіційні назви проєктів сягають 126 символів — як заголовок сторінки
        вони нечитабельні: пошуковик показує перші 60-65 і ріже решту на
        півслові. Фільтр лишає початок І кінець назви (саме кінець їх і
        розрізняє), повна назва лишається в h1 і в og:title, де місця
        більше. Статичні сторінки мають рукописні заголовки в межах
        норми — їх не чіпаємо. -#}
    {%- if isNewsPost or isProjectPost %}
    <title>{{ artTitle | seotitle }} | ICDF</title>
    {%- else %}
    <title>{{ title }}</title>
    {%- endif %}
    <meta name="description" content="{{ description or excerpt }}">
    {%- if noindex %}
    <meta name="robots" content="noindex">
    {%- else %}
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">
    <link rel="alternate" hreflang="uk" href="{{ site.url }}{{ page.url if locale == 'uk' else altUrl }}">
    <link rel="alternate" hreflang="en" href="{{ site.url }}{{ page.url if locale == 'en' else altUrl }}">
    <link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ page.url if locale == 'uk' else altUrl }}">
    {%- endif %}
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon-16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png">
    <meta name="theme-color" content="#5A7D3D">
    <meta property="og:type" content="{{ 'article' if isNewsPost or isProjectPost else 'website' }}">
    <meta property="og:site_name" content="{{ site.orgFull }}">
    <meta property="og:title" content="{{ title }}">
    <meta property="og:description" content="{{ description or excerpt }}">
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    <meta property="og:image" content="{{ pageImageUrl }}">
    <meta property="og:locale" content="{{ 'en_US' if locale == 'en' else 'uk_UA' }}">
    <meta name="twitter:card" content="summary_large_image">
    {#- Шрифти self-hosted (@font-face у styles.css). Preload лише для тих
        підмножин, які потрібні для першого екрана: latin — завжди (цифри,
        «ICDF», латинські назви), cyrillic — тільки на українській версії,
        інакше браузер сварився б на завантажений і не використаний файл.
        crossorigin обовʼязковий навіть для свого домену: шрифти
        завантажуються в CORS-режимі, без нього буде другий запит. -#}
    <link rel="preload" href="/assets/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/assets/fonts/onest-latin.woff2" as="font" type="font/woff2" crossorigin>
    {%- if locale != "en" %}
    <link rel="preload" href="/assets/fonts/inter-cyrillic.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/assets/fonts/onest-cyrillic.woff2" as="font" type="font/woff2" crossorigin>
    {%- endif %}
    <link rel="stylesheet" href="/styles.css">
{%- if not noindex %}
{#- Структуровані дані Schema.org. Один <script> з @graph замість кількох
    блоків: вузли посилаються один на одного через @id, тож пошуковик бачить
    їх як одну сутність, а не як чотири незалежні описи.
    Кожне значення проходить через | dump — це JSON.stringify, тому лапки,
    тире й переноси в заголовках новин екрануються самі. Порожні поля
    (соцмережі, ЄДРПОУ) не виводимо взагалі: порожній рядок у розмітці
    гірший за його відсутність. -#}
{%- set socialLinks = [] %}
{%- if contacts.socials %}{% for k, v in contacts.socials %}{% if v %}{% set _ = socialLinks.push(v) %}{% endif %}{% endfor %}{% endif %}
{%- set identifiers = [] %}
{%- if legal.registration %}{% for r in legal.registration %}{% if r.value %}{% set _ = identifiers.push({"@type": "PropertyValue", "name": r.label, "value": r.value}) %}{% endif %}{% endfor %}{% endif %}
{#- Адреса в contacts.json — один рядок, що завершується «…, місто, індекс, країна».
    Читаємо з кінця: країна, індекс, місто — три останні частини, решта
    складається у streetAddress. Так формат витримує і «вул. Межова, 23,
    (Подільський район), м. Київ, 04215, Україна», і коротший запис без
    району. Якщо частин менше чотирьох — віддаємо рядок цілком, аби не
    вигадувати дані. -#}
{%- set addrParts = contacts.address.split(",") if contacts.address else [] %}
{%- set postalAddress = null %}
{%- if addrParts.length >= 4 %}
{%- set n = addrParts.length %}
{#- addressCountry за schema.org — код ISO 3166-1, а не назва країни:
    у полі CMS вона написана словом і різною мовою в кожній локалі. -#}
{%- set postalAddress = {"@type": "PostalAddress", "streetAddress": addrParts.slice(0, n - 3) | join(",") | trim, "addressLocality": addrParts[n - 3] | trim, "postalCode": addrParts[n - 2] | trim, "addressCountry": "UA"} %}
{%- elif contacts.address %}
{%- set postalAddress = {"@type": "PostalAddress", "streetAddress": contacts.address} %}
{%- endif %}
{%- set orgId = site.url + "/#organization" %}
{%- set siteId = site.url + "/#website" %}
{%- set pageId = site.url + page.url + "#webpage" %}
{%- set jsonLd %}
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "NGO",
      "@id": {{ orgId | dump | safe }},
      "name": {{ site.orgFull | dump | safe }},
      "alternateName": {{ ([site.orgShort, site.orgEnglish] if site.orgEnglish and site.orgEnglish != site.orgFull else [site.orgShort]) | dump | safe }},
      "url": {{ (site.url + "/") | dump | safe }},
      "logo": {
        "@type": "ImageObject",
        "url": {{ (site.url + "/assets/apple-touch-icon.png") | dump | safe }},
        "width": 180,
        "height": 180
      },
      "image": {{ (site.url + "/assets/og-image.jpg") | dump | safe }}
      {%- if contacts.general %},
      "email": {{ contacts.general | dump | safe }}{% endif %}
      {%- if contacts.phone %},
      "telephone": {{ contacts.phone | dump | safe }},
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "customer support",
        "telephone": {{ contacts.phone | dump | safe }}{% if contacts.general %},
        "email": {{ contacts.general | dump | safe }}{% endif %},
        "availableLanguage": ["uk", "en"]
      }{% endif %}
      {%- if postalAddress %},
      "address": {{ postalAddress | dump | safe }}{% endif %}
      {%- if socialLinks.length %},
      "sameAs": {{ socialLinks | dump | safe }}{% endif %}
      {%- if legal.edrpou %},
      "taxID": {{ legal.edrpou | dump | safe }},
      "vatID": {{ legal.edrpou | dump | safe }}{% endif %}
      {%- if identifiers.length %},
      "identifier": {{ identifiers | dump | safe }}{% endif %}
    },
    {
      "@type": "WebSite",
      "@id": {{ siteId | dump | safe }},
      "url": {{ (site.url + "/") | dump | safe }},
      "name": {{ site.orgFull | dump | safe }},
      "inLanguage": {{ locale | dump | safe }},
      "publisher": { "@id": {{ orgId | dump | safe }} }
    },
    {
      "@type": {{ ("ContactPage" if isContactPage else "WebPage") | dump | safe }},
      "@id": {{ pageId | dump | safe }},
      "url": {{ (site.url + page.url) | dump | safe }},
      "name": {{ title | dump | safe }},
      "inLanguage": {{ locale | dump | safe }},
      "isPartOf": { "@id": {{ siteId | dump | safe }} },
      "about": { "@id": {{ orgId | dump | safe }} },
      "primaryImageOfPage": {{ pageImageUrl | dump | safe }}
      {%- if description or excerpt %},
      "description": {{ (description or excerpt) | dump | safe }}{% endif %}
      {%- if isContactPage %},
      "mainEntity": { "@id": {{ orgId | dump | safe }} }{% endif %}
    }
    {%- if isNewsPost or isProjectPost %},
    {
      "@type": {{ ("NewsArticle" if isNewsPost else "Article") | dump | safe }},
      "@id": {{ (site.url + page.url + "#article") | dump | safe }},
      "headline": {{ artTitle | dump | safe }},
      "url": {{ (site.url + page.url) | dump | safe }},
      "inLanguage": {{ locale | dump | safe }},
      "image": {{ pageImageUrl | dump | safe }},
      "mainEntityOfPage": { "@id": {{ pageId | dump | safe }} },
      "author": { "@id": {{ orgId | dump | safe }} },
      "publisher": { "@id": {{ orgId | dump | safe }} }
      {%- if artDate %},
      "datePublished": {{ artDate | dump | safe }},
      "dateModified": {{ artDate | dump | safe }}{% endif %}
      {%- if artExcerpt %},
      "description": {{ artExcerpt | dump | safe }}{% endif %}
    }
    {%- endif %}
  ]
}
{%- endset %}
{#- «</» усередині JSON рвало б <script> ще до кінця розмітки; \/ — легальний
    JSON-escape, тож вміст лишається розбірним. -#}
    <script type="application/ld+json">{{ jsonLd | replace("</", "<\\/") | safe }}</script>
{%- endif %}
  </head>
  <body>
    {#- Перша зупинка Tab: до основного вмісту інакше треба пройти
        десяток посилань шапки на кожній сторінці. Видиме лише у фокусі. -#}
    <a class="skip-link" href="#main">{{ "Skip to content" if locale == "en" else "Перейти до вмісту" }}</a>
{%- if legal.registration %}
    <div class="reg-strip">
      <ul>
        {%- for r in legal.registration %}
        <li><span>{{ r.label }}</span> <b>{{ r.value }}</b></li>
        {%- endfor %}
      </ul>
    </div>
{%- endif %}
{% include "header.njk" %}
    <main id="main" tabindex="-1">
{{ content | safe }}
    </main>
{% include "footer.njk" %}
    {%- if site.cookie and site.cookie.text %}
    {#- Смуга згоди на cookie. Ховається до рішення користувача через
        hidden, щоб не блимала при завантаженні; вибір лишається в
        localStorage, тож більше не показується. -#}
    <div class="cookie-bar" id="cookie-bar" role="region" aria-label="{{ 'Cookie notice' if locale == 'en' else 'Повідомлення про cookie' }}" hidden>
      <p>{{ site.cookie.text }} <a href="{{ site.cookie.linkUrl }}">{{ site.cookie.linkLabel }} ↗</a></p>
      <button class="button button-accent" type="button" id="cookie-accept">{{ site.cookie.buttonLabel }}</button>
    </div>
    {%- endif %}
    <script>
      (function () {
        var d = document, root = d.documentElement;
        root.classList.add('js');

        /* Згода на cookie: показуємо смугу лише тим, хто ще не відповів. */
        var cookieBar = d.getElementById('cookie-bar');
        if (cookieBar) {
          var stored = null;
          try { stored = localStorage.getItem('icdf-cookie-consent'); } catch (e) {}
          /* Смуга висить fixed над контентом, тож поки вона видима —
             резервуємо під неї місце внизу сторінки. Інакше вона накриває
             нижній ряд кнопок і футер, і тап по них не доходить до цілі. */
          var reserve = function () {
            if (cookieBar.hidden) return;
            var h = cookieBar.offsetHeight + 32;
            d.body.style.paddingBottom = h + 'px';
            root.style.scrollPaddingBottom = h + 'px';
          };
          var release = function () {
            d.body.style.paddingBottom = '';
            root.style.scrollPaddingBottom = '';
          };
          if (!stored) {
            cookieBar.hidden = false;
            reserve();
            window.addEventListener('resize', reserve, { passive: true });
            requestAnimationFrame(function () { cookieBar.classList.add('in'); });
          }
          var accept = d.getElementById('cookie-accept');
          if (accept) {
            accept.addEventListener('click', function () {
              try { localStorage.setItem('icdf-cookie-consent', 'accepted'); } catch (e) {}
              cookieBar.classList.remove('in');
              release();
              setTimeout(function () { cookieBar.hidden = true; }, 450);
            });
          }
        }

        var header = d.querySelector('.site-header');
        var toggle = d.querySelector('.nav-toggle');

        if (header && toggle) {
          var closeNav = function (focusToggle) {
            if (!header.classList.contains('nav-open')) return;
            header.classList.remove('nav-open');
            toggle.setAttribute('aria-expanded', 'false');
            if (focusToggle) toggle.focus();
          };
          toggle.addEventListener('click', function () {
            var open = header.classList.toggle('nav-open');
            toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
          });
          header.querySelectorAll('.nav a').forEach(function (a) {
            a.addEventListener('click', function () { closeNav(false); });
          });
          /* Меню має закриватися звичними способами, а не лише повторним
             влучанням у бургер. */
          d.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' || e.key === 'Esc') closeNav(true);
          });
          d.addEventListener('click', function (e) {
            if (!header.contains(e.target)) closeNav(false);
          });
        }

        var lastY = 0, ticking = false;
        window.addEventListener('scroll', function () {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(function () {
            var y = window.pageYOffset || 0;
            if (header) header.classList.toggle('scrolled', y > 24);
            if (header && !header.classList.contains('nav-open')) {
              if (y > 120 && y > lastY) header.classList.add('header-hidden');
              else header.classList.remove('header-hidden');
            }
            lastY = y;
            ticking = false;
          });
        }, { passive: true });

        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        /* ротація акцентного слова в H1 (2.2s). Ширина фіксується під
           найдовше слово, щоб заголовок не перескакував між словами. */
        var accent = d.querySelector('.hero-top h1 .accent');
        if (accent && !reduce) {
          var words = root.lang === 'en'
            ? ['future', 'security', 'resilience', 'development']
            : ['майбутнє', 'безпеку', 'стійкість', 'розвиток'];
          var wi = Math.max(0, words.indexOf(accent.textContent.trim()));
          var soft = 'cubic-bezier(0.22, 0.61, 0.36, 1)';
          var show = 'opacity 420ms ' + soft + ', transform 420ms ' + soft;
          accent.style.display = 'inline-block';
          accent.style.transition = show;
          var maxWidth = 0;
          words.forEach(function (w) {
            accent.textContent = w;
            maxWidth = Math.max(maxWidth, accent.getBoundingClientRect().width);
          });
          accent.style.width = Math.ceil(maxWidth) + 'px';
          accent.textContent = words[wi];
          setInterval(function () {
            accent.style.opacity = '0';
            accent.style.transform = 'translateY(0.45em)';
            setTimeout(function () {
              wi = (wi + 1) % words.length;
              accent.textContent = words[wi];
              accent.style.transition = 'none';
              accent.style.transform = 'translateY(-0.45em)';
              void accent.offsetHeight;
              accent.style.transition = show;
              accent.style.opacity = '1';
              accent.style.transform = 'translateY(0)';
            }, 440);
          }, 2600);
        }
        if (reduce || !('IntersectionObserver' in window)) return;
{%- if page.url == "/" or page.url == "/en/" %}
        /* Анімація появи при скролі лишається тільки на головній —
           на внутрішніх сторінках вона заважає читати. */
        var sel = '.section-heading,.intro-photos,.intro-story-top > p,' +
          '.map-card,.cards-grid article,.process-grid article,' +
          '.resource-card,.partner-marquee,.partner-detail-card,.news-mini-grid article,.news-grid article,' +
          '.principles-grid article,.capacity-grid article,.about-note,.about-copy,' +
          '.team-leads article,.team-grid article,.feedback-form,' +
          '.project-list > *,.contact-list span,.award-card,.cta-band > div';
        var els = [].slice.call(d.querySelectorAll(sel));
        els.forEach(function (el) {
          el.setAttribute('data-reveal', '');
          var p = el.parentNode, idx = p ? [].indexOf.call(p.children, el) : 0;
          el.style.transitionDelay = (Math.min(idx, 6) * 60) + 'ms';
        });
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
          });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
        els.forEach(function (el) { io.observe(el); });
{%- endif %}
      })();
    </script>
  </body>
</html>
