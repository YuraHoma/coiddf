---
layout: base.njk
pagination:
  data: locales
  size: 1
  alias: locale
  addAllPagesToCollections: true
permalink: "{{ '/en/partnery/' if locale == 'en' else '/partnery/' }}"
title: Партнери | Фонд розвитку міжнародної співпраці
description: Українські та міжнародні партнери фонду.
enTitle: Partners | International Cooperation Development Fund
enDescription: Ukrainian and international partners of the fund.
eleventyComputed:
  title: "{{ (enTitle if locale == 'en' else title) | safe }}"
  description: "{{ (enDescription if locale == 'en' else description) | safe }}"
---
{% import "partner-logos.njk" as logos %}
      <section class="page-hero">
        <div>
          <p class="eyebrow">{{ partners.hero.eyebrow }}</p>
          <h1>{{ partners.hero.heading }}</h1>
          <p class="lead">{{ partners.hero.lead }}</p>
        </div>
      </section>
      <section class="section">
        <div class="partners-grid">
          {%- for p in partners.items %}
          <article class="partner-detail-card">
            <div class="partner-detail-mark">{{ logos.logo(p) }}</div>
            {% if p.description %}<p>{{ p.description }}</p>{% endif %}
          </article>
          {%- endfor %}
        </div>
        {%- if partners.note %}
        <p class="partners-note">{{ partners.note }}</p>
        {%- endif %}
      </section>
