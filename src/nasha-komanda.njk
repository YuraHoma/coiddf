---
layout: base.njk
pagination:
  data: locales
  size: 1
  alias: locale
  addAllPagesToCollections: true
permalink: "{{ '/en/nasha-komanda/' if locale == 'en' else '/nasha-komanda/' }}"
title: Наша команда | Фонд розвитку міжнародної співпраці
description: Команда фонду — засновники, менеджери, бухгалтерія, склад і волонтери.
enTitle: Our Team | International Cooperation Development Fund
enDescription: The foundation's team includes founders, managers, accounting, staff and volunteers.
eleventyComputed:
  title: "{{ enTitle if locale == 'en' else title }}"
  description: "{{ enDescription if locale == 'en' else description }}"
---
      <section class="page-hero">
        <div>
          <p class="eyebrow">{{ team.hero.eyebrow }}</p>
          <h1>{{ team.hero.heading }}</h1>
          <p class="lead">{{ team.hero.lead }}</p>
        </div>
      </section>
      <section class="section">
        <div class="team-leads">
          {%- for m in team.members %}
          {%- if loop.index0 < 2 %}
          <article>
            <div class="team-photo">{% if m.photo %}<img src="{{ m.photo }}" alt="{{ m.name or m.role }}" loading="lazy">{% endif %}</div>
            <span>{{ m.role }}</span>
            {% if m.name %}<h3>{{ m.name }}</h3>{% endif %}
            {% if m.bio %}<p>{{ m.bio }}</p>{% endif %}
          </article>
          {%- endif %}
          {%- endfor %}
        </div>
        <div class="team-grid team-grid--staff">
          {%- for m in team.members %}
          {%- if loop.index0 >= 2 %}
          <article>
            <div class="team-photo">{% if m.photo %}<img src="{{ m.photo }}" alt="{{ m.name or m.role }}" loading="lazy">{% endif %}</div>
            <span>{{ m.role }}</span>
            {% if m.name %}<h3>{{ m.name }}</h3>{% endif %}
            {% if m.bio %}<p>{{ m.bio }}</p>{% endif %}
          </article>
          {%- endif %}
          {%- endfor %}
        </div>
      </section>
