---
layout: base.njk
pagination:
  data: locales
  size: 1
  alias: locale
  addAllPagesToCollections: true
permalink: "{{ '/en/pro-nas/' if locale == 'en' else '/pro-nas/' }}"
title: Про нас | Фонд розвитку міжнародної співпраці
description: Місія, стратегія, підхід та принципи благодійного фонду.
enTitle: About Us | International Cooperation Development Fund
enDescription: Mission, strategy, approach and principles of the charitable foundation.
eleventyComputed:
  title: "{{ enTitle if locale == 'en' else title }}"
  description: "{{ enDescription if locale == 'en' else description }}"
---
      <section class="about-hero">
        <img src="{{ pronas.hero.image }}" alt="{{ pronas.hero.imageAlt }}">
        <div>
          <p class="eyebrow">{{ pronas.hero.eyebrow }}</p>
          <h1>{{ pronas.hero.heading }}</h1>
          <p class="lead">{{ pronas.hero.lead }}</p>
        </div>
      </section>
      <section class="section about-layout">
        <div class="about-note">
          {%- for m in pronas.mission %}
          <h3>{{ m.title }}</h3>
          <p>{{ m.body }}</p>
          {%- endfor %}
        </div>
        <div class="about-copy">
          {%- for p in pronas.story %}
          <p>{{ p }}</p>
          {%- if loop.first and pronas.storyHighlight %}
          <p class="story-highlight">{{ pronas.storyHighlight }}</p>
          {%- endif %}
          {%- endfor %}
        </div>
      </section>
      <section class="section">
        <div class="section-heading center"><p class="eyebrow">{{ pronas.approach.eyebrow }}</p><h2>{{ pronas.approach.heading }}</h2></div>
        <div class="cards-grid">
          {%- for it in pronas.approach.items %}
          <article><h3>{{ it.title }}</h3><p>{{ it.text }}</p></article>
          {%- endfor %}
        </div>
      </section>
      <section class="section">
        <div class="capacity-panel">
          <div class="section-heading center"><p class="eyebrow">{{ pronas.capacity.eyebrow }}</p><h2>{{ pronas.capacity.heading }}</h2></div>
          <p class="capacity-intro">{{ pronas.capacity.intro }}</p>
          {%- if pronas.capacity.listIntro %}
          <p class="capacity-list-intro">{{ pronas.capacity.listIntro }}</p>
          {%- endif %}
          <div class="capacity-grid">
            {%- for it in pronas.capacity.items %}
            <article><p><strong>{{ it.title }}</strong> {{ it.text }}</p></article>
            {%- endfor %}
          </div>
          <p class="capacity-note">{{ pronas.capacity.note }}</p>
        </div>
      </section>
      <section class="section">
        <div class="section-heading center"><p class="eyebrow">{{ pronas.principles.eyebrow }}</p><h2>{{ pronas.principles.heading }}</h2></div>
        <div class="principles-grid">
          {%- for it in pronas.principles.items %}
          <article><h3>{{ it.title }}</h3><p>{{ it.text }}</p></article>
          {%- endfor %}
        </div>
      </section>
      <section class="section">
        <div class="section-heading center"><h2>{{ pronas.awards.heading }}</h2></div>
        <div class="awards-grid">
          {%- for a in pronas.awards.items %}
          <figure class="award-card">
            <a href="{{ a.imageEn if locale == 'en' else a.image }}" target="_blank" rel="noopener">
              <img src="{{ a.imageEn if locale == 'en' else a.image }}" alt="{{ a.title }}" loading="lazy">
            </a>
          </figure>
          {%- endfor %}
        </div>
      </section>
