---
layout: base.njk
pagination:
  data: locales
  size: 1
  alias: locale
  addAllPagesToCollections: true
permalink: "{{ '/en/proyekty/' if locale == 'en' else '/proyekty/' }}"
title: Проєкти | Фонд розвитку міжнародної співпраці
description: Гуманітарні, освітні та відновлювальні проєкти фонду.
enTitle: Projects | International Cooperation Development Fund
enDescription: Humanitarian, educational and restoration projects of the fund.
eleventyComputed:
  title: "{{ enTitle if locale == 'en' else title }}"
  description: "{{ enDescription if locale == 'en' else description }}"
---
      <section class="page-hero">
        <div>
          <p class="eyebrow">{{ proyekty.hero.eyebrow }}</p>
          <h1>{{ proyekty.hero.heading }}</h1>
          <p class="lead">{{ proyekty.hero.lead }}</p>
        </div>
      </section>
      {%- set projectList = en.projects if locale == "en" else collections.projects %}
      {%- for d in proyekty.directions.items %}
      {%- set group = [] %}
      {%- for p in projectList %}{% if p.data.direction == d.key %}{% set group = (group.push(p), group) %}{% endif %}{% endfor %}
      {%- if group.length %}
      <section class="section" id="{{ d.key }}">
        <div class="section-heading center"><h2>{{ d.title }}</h2></div>
        <div class="project-list">
          {%- for p in group %}
          {%- set pUrl = p.data.url if locale == "en" else p.url %}
          <article>
            {% if p.data.image %}<div class="project-media"><img src="{{ p.data.image }}" alt="{{ p.data.title }}" loading="lazy"></div>{% else %}<div class="project-media news-img-placeholder"></div>{% endif %}
            <div class="project-body">
              <span>{{ p.data.date | uadate }}</span>
              <h3>{{ p.data.title }}</h3>
              <p>{{ p.data.excerpt }}</p>
              <a class="button button-outline project-more-link" href="{{ pUrl }}">{{ proyekty.detailsLabel }} ↗</a>
            </div>
          </article>
          {%- endfor %}
        </div>
      </section>
      {%- endif %}
      {%- endfor %}
