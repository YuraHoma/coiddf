---
layout: base.njk
pagination:
  data: locales
  size: 1
  alias: locale
  addAllPagesToCollections: true
permalink: "{{ '/en/novyny/' if locale == 'en' else '/novyny/' }}"
title: Новини | Фонд розвитку міжнародної співпраці
description: Останні новини та оновлення фонду.
enTitle: News | International Cooperation Development Fund
enDescription: Latest fund news and updates.
eleventyComputed:
  title: "{{ (enTitle if locale == 'en' else title) | safe }}"
  description: "{{ (enDescription if locale == 'en' else description) | safe }}"
---
{% import "news-card.njk" as news %}
      <section class="page-hero">
        <div>
          <p class="eyebrow">{{ novyny.hero.eyebrow }}</p>
          <h1>{{ novyny.hero.heading }}</h1>
          <p class="lead">{{ novyny.hero.lead }}</p>
        </div>
      </section>
      <section class="section">
        <div class="news-grid">
          {%- set newsList = en.newsPosts if locale == "en" else collections.news %}
          {%- for post in newsList %}
{{ news.newsCard(post, true, locale) }}
          {%- endfor %}
        </div>
      </section>
