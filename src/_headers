# Security headers — served by Cloudflare (Workers static assets / Pages).
#
# УВАГА про вбудовування (frame-ancestors / X-Frame-Options): Cloudflare не
# ЗАМІНЮЄ значення в частковому правилі, а ДОДАЄ другий заголовок. Два
# заголовки браузер зводить до найсуворішого, тож окреме послаблення для
# PDF не працювало — переглядач документів на сторінці правової інформації
# лишався заблокованим. Тому дозвіл на вбудовування задано одразу тут:
# 'self' забороняє чужим сайтам вставляти нас у рамку так само, як 'none',
# і при цьому лишає нам можливість показувати власні PDF на власній сторінці.
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'

# Похідні зображення безпечно кешувати назавжди: імʼя файлу генерує
# eleventy-img з хешу вмісту, тож інший вміст — інша адреса.
# Без цього браузер перепитував кожен файл на кожному переході.
/assets/opt/*
  Cache-Control: public, max-age=31536000, immutable

# УВАГА: імена шрифтів фіксовані (inter-latin.woff2 тощо), хеша в них
# немає. Якщо колись міняти сам файл шрифту — його треба перейменувати,
# інакше в тих, хто вже був на сайті, лишиться стара версія на рік.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Документи оновлюють рідко, але не «ніколи»: імена в них людські, без
# хеша, тож кешуємо на годину — заміна файлу дійде до людей того ж дня.
/assets/*.pdf
  Cache-Control: public, max-age=3600
