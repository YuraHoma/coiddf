{
  // Основний воркер сайту — адреса, яку має клієнт:
  // https://icdf-preview.homchenkoyura.workers.dev
  "name": "icdf-preview",
  "compatibility_date": "2026-06-14",
  // Воркер обробляє POST /api/contact, решту віддає статикою.
  "main": "worker/index.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "_site",
    "binding": "ASSETS",
    // serve our custom /404.html for missing paths
    "not_found_handling": "404-page",
    // Воркер має бачити КОЖЕН запит, а не лише ті, під які немає файлу:
    // інакше перенаправлення з www і зі старої тимчасової адреси на
    // головний домен не спрацьовує — статика віддається раніше.
    "run_worker_first": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
