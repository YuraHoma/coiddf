{
  // Основний воркер сайту. Адреса сайту — https://coicdf.org (див.
  // "routes" нижче); стара https://icdf-preview.homchenkoyura.workers.dev
  // лишається робочою і перенаправляє на неї.
  "name": "icdf-preview",
  "compatibility_date": "2026-06-14",
  // Воркер обробляє POST /api/contact, решту віддає статикою.
  "main": "worker/index.js",
  // Власний домен фонду. Wrangler сам створює потрібні DNS-записи в зоні
  // coicdf.org і випускає сертифікат — руками в панелі нічого не додаємо,
  // тож і при передачі проєкту клієнту домен описаний тут, у репозиторії.
  // «www» лишається робочим і веде на головну адресу (див. worker/index.js).
  // Стару адресу на workers.dev тримаємо ввімкненою свідомо: посилання на
  // неї вже розійшлися листами, а воркер перенаправляє з неї на coicdf.org
  // (див. worker/index.js). Без цього рядка wrangler вимикає піддомен
  // автоматично, щойно в конфігурації зʼявляються "routes", — і старі
  // посилання починають віддавати помилку 1042 замість переходу на сайт.
  "workers_dev": true,
  "routes": [
    { "pattern": "coicdf.org", "custom_domain": true },
    { "pattern": "www.coicdf.org", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "_site",
    "binding": "ASSETS",
    // serve our custom /404.html for missing paths
    "not_found_handling": "404-page",
    // Воркер має бачити КОЖЕН запит, а не лише ті, під які немає файлу:
    // інакше перенаправлення з www і зі старої тимчасової адреси на
    // головний домен не спрацьовує — статика віддається раніше.
    "run_worker_first": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
